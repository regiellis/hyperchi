{{define "index"}}
<div class="max-w-4xl mx-auto px-6 py-16 md:py-24">

    <!-- Hero -->
    <section class="mb-20">
        <h1 class="font-serif text-5xl md:text-7xl text-slate-900 dark:text-white leading-[1.05] tracking-tight mb-6">
            HyperChi
        </h1>
        <p class="font-serif italic text-2xl md:text-3xl text-slate-600 dark:text-slate-400 leading-snug max-w-2xl">
            A Go web framework with HTMX 4 and a tiny declarative directive engine.
        </p>
        <p class="mt-8 text-slate-700 dark:text-slate-300 max-w-2xl leading-relaxed">
            Server-render with Go. Swap fragments with HTMX. Reach for
            <code class="font-mono text-sm bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">hc-*</code> directives only when
            you need local reactivity. No build-time compiler, no virtual DOM, one binary at the end.
        </p>

        <div class="mt-10 flex gap-3">
            <a href="/docs/directives" class="inline-flex items-center gap-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors" hx-boost="true">
                Read the docs <span aria-hidden="true">→</span>
            </a>
            <a href="https://github.com/regiellis/hyperchi" target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-slate-300 dark:border-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors">
                GitHub
            </a>
        </div>
    </section>

    <!-- Topic cards -->
    <section class="mb-20">
        <h2 class="font-serif text-3xl text-slate-900 dark:text-white mb-2">What's inside</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-8">Four short reads. Each demonstrates the pattern it documents.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="/docs/directives" class="topic-card" hx-boost="true">
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Reactive HTML</div>
                <div class="font-serif text-2xl text-slate-900 dark:text-white mb-2">Directives</div>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    <code class="font-mono">hc-data</code>, <code class="font-mono">hc-on</code>, <code class="font-mono">hc-text</code>,
                    <code class="font-mono">hc-show</code>, <code class="font-mono">hc-persist</code> &amp; friends.
                </p>
            </a>
            <a href="/docs/htmx" class="topic-card" hx-boost="true">
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Server interactions</div>
                <div class="font-serif text-2xl text-slate-900 dark:text-white mb-2">HTMX</div>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    Fragment swaps, request triggers, boosted links: the htmx 4 attribute set.
                </p>
            </a>
            <a href="/docs/view-transitions" class="topic-card" hx-boost="true">
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Animations</div>
                <div class="font-serif text-2xl text-slate-900 dark:text-white mb-2">View Transitions</div>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    Astro-style cross-page morph with <code class="font-mono">data-vt-name</code>.
                </p>
            </a>
            <a href="/docs/deploy" class="topic-card" hx-boost="true">
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Production</div>
                <div class="font-serif text-2xl text-slate-900 dark:text-white mb-2">Deploy</div>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    <code class="font-mono">task build</code> ships a static binary plus a <code class="font-mono">dist/</code> dir.
                </p>
            </a>
        </div>
    </section>

    <!-- Live demo -->
    <section class="mb-12" hc-data="welcome">
        <h2 class="font-serif text-3xl text-slate-900 dark:text-white mb-2">Try it</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6">Two interactive snippets: one client-side, one round-trip.</p>

        <div class="demo">
            <div class="demo-label">Directive: local reactive state</div>
            <div class="flex items-center gap-3">
                <button class="bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-4 py-2 rounded-md text-sm font-medium"
                        hc-on:click="n++">
                    Increment
                </button>
                <span class="text-slate-700 dark:text-slate-300 text-sm">
                    Count: <strong hc-text="n">0</strong>
                </span>
            </div>
            <pre class="code-block mt-4" data-lang="html"><code>&lt;div hc-data=&quot;welcome&quot;&gt;
  &lt;button hc-on:click=&quot;n++&quot;&gt;Increment&lt;/button&gt;
  &lt;span&gt;Count: &lt;strong hc-text=&quot;n&quot;&gt;0&lt;/strong&gt;&lt;/span&gt;
&lt;/div&gt;
&lt;script&gt;
  HyperChi.registerComponent('welcome', () =&gt; ({ n: 0 }))
&lt;/script&gt;</code></pre>
        </div>

        <div class="demo mt-4">
            <div class="demo-label">HTMX: server-rendered fragment swap</div>
            <div class="flex items-center gap-3 flex-wrap">
                <button class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-md text-sm font-medium"
                        hx-get="/api/time"
                        hx-target="#welcome-time"
                        hx-swap="innerHTML">
                    What time is it?
                </button>
                <span id="welcome-time" class="text-sm text-slate-600 dark:text-slate-400">
                    Click for the server time.
                </span>
            </div>
            <pre class="code-block mt-4" data-lang="html"><code>&lt;button hx-get=&quot;/api/time&quot;
        hx-target=&quot;#out&quot;
        hx-swap=&quot;innerHTML&quot;&gt;
  What time is it?
&lt;/button&gt;
&lt;span id=&quot;out&quot;&gt;Click for the server time.&lt;/span&gt;</code></pre>
        </div>
    </section>

    <hr class="border-slate-200 dark:border-slate-800 my-12">

    <p class="text-sm text-slate-500">
        Edit <code class="font-mono">templates/pages/index.tmpl</code> to make this your own.
        <code class="font-mono">task dev</code> reloads the page on save.
    </p>

</div>
<script>
  HyperChi.registerComponent('welcome', () => ({ n: 0 }))
</script>
{{end}}
