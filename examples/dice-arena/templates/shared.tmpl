{{define "rules"}}
<details class="rules" id="rules">
  <summary>How to play Hot Dice</summary>
  <div class="rules-body">
    <ol class="rules-steps">
      <li>On your turn, roll six dice.</li>
      <li>After every roll, set aside at least one scoring die. Then roll the rest again, or bank the points you set aside this turn.</li>
      <li>A roll with nothing that scores is a bust: you lose the points from this turn and the dice pass on.</li>
      <li>Set aside all six dice and you have hot dice: roll all six again and keep building the turn.</li>
      <li>A turn has at most {{.maxRolls}} rolls. After the last one, bank.</li>
      <li>The first player to reach the target wins.</li>
    </ol>
    <table class="scoring">
      <caption>Scoring</caption>
      <thead><tr><th scope="col">Dice</th><th scope="col">Points</th></tr></thead>
      <tbody>
        <tr><td>Each 1</td><td class="num">100</td></tr>
        <tr><td>Each 5</td><td class="num">50</td></tr>
        <tr><td>Three 1s</td><td class="num">1,000</td></tr>
        <tr><td>Three of any other face</td><td class="num">face × 100</td></tr>
        <tr><td>Each extra matching die</td><td class="num">doubles it</td></tr>
        <tr><td>Straight, 1 to 6</td><td class="num">1,500</td></tr>
        <tr><td>Three pairs</td><td class="num">750</td></tr>
      </tbody>
    </table>
    <p class="note">Dice you set aside together must all score. Dice set aside in different rolls never combine.</p>
  </div>
</details>
{{end}}

{{define "error"}}
<main id="main" class="page error-page">
  <p class="eyebrow">Error {{.status}}</p>
  <h1>{{.message}}</h1>
  {{range $field, $msgs := .fields}}<p class="field-error">{{$field}} {{index $msgs 0}}.</p>{{end}}
  <p><a class="btn" href="/">Back to the lobby</a></p>
</main>
{{end}}
