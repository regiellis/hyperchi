# HyperChi Application Environment Variables
# Copy this file to .env and update with your values

# Application Configuration
APP_NAME=hyperchi-app
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database Configuration
DB_PATH=./app.db
DB_DEBUG=false

# Security Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-jwt-secret-key-change-this-in-production
SESSION_SECRET=your-session-secret-key-change-this-in-production
CSRF_SECRET=your-csrf-secret-key-change-this-in-production

# Admin User Configuration (CHANGE THESE IN PRODUCTION!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
ADMIN_NAME=Administrator

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s

# CORS Configuration
# In development (GO_ENV=development or unset): defaults to "*" (all origins allowed)
# In production (GO_ENV=production): no CORS headers unless CORS_ORIGINS is set
# CORS_ORIGINS=*
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Content Security Policy (optional, overrides default)
# CSP_POLICY=default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline';

# Logging
LOG_LEVEL=INFO
LOG_COLORED=true
LOG_SHOW_CALLER=false

# Asset Pipeline
ASSETS_MINIFY=false
ASSETS_VERSIONING=false
ASSETS_HOT_RELOAD=true

# Content Management
CONTENT_WATCH_CHANGES=true
CONTENT_CACHE_ENABLED=true

# Performance
CACHE_ENABLED=true
CACHE_TTL=3600
MAX_UPLOAD_SIZE=10MB

# External Services (Optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=smtp-password
# REDIS_URL=redis://localhost:6379
# POSTGRES_URL=postgres://user:pass@localhost/dbname