{{define "games"}}
<div class="wrap">
  <header class="page-head">
    <p class="eyebrow">Games</p>
    <h1>Three games about keeping things running</h1>
    <p class="lede">A wall, a clock, a ferry. Each one is small, quiet, and finished with care.</p>
  </header>
  <ul class="game-list">
    {{- range .games}}
    <li>
      <article class="game-row">
        <a class="game-row-art" href="{{.Path}}" tabindex="-1" aria-hidden="true"><img src="{{asset .Cover.Src}}" alt="" width="1200" height="630" loading="lazy" decoding="async"></a>
        <div class="game-row-body">
          <p><span class="status status-{{.StatusKind}}">{{.Status}}</span></p>
          <h2><a href="{{.Path}}">{{.Title}}</a></h2>
          <p class="lede">{{.Tagline}}</p>
          <p>{{.Summary}}</p>
          <p class="platforms">{{.Genre}}<span aria-hidden="true"> · </span>{{join .Platforms ", "}}</p>
        </div>
      </article>
    </li>
    {{- end}}
  </ul>
</div>
{{end}}

{{define "game"}}{{with .game}}
<article class="game">
  <header class="game-hero">
    <div class="wrap game-hero-grid">
      <div class="game-hero-copy">
        <p class="eyebrow"><a href="/games">Games</a><span aria-hidden="true"> · </span>{{.Genre}}</p>
        <h1>{{.Title}}</h1>
        <p class="lede">{{.Tagline}}</p>
        <p><span class="status status-{{.StatusKind}}">{{.Status}}</span></p>
        <div class="actions">
          {{- range $i, $store := .Stores}}
          <a class="button{{if $i}} button-quiet{{end}}" href="{{$store.URL}}" rel="external">{{if eq $.game.StatusKind "released"}}Buy on{{else}}Wishlist on{{end}} {{$store.Label}}</a>
          {{- end}}
        </div>
      </div>
      <img class="game-cover" src="{{asset .Cover.Src}}" alt="{{.Cover.Alt}}" width="1200" height="630" fetchpriority="high">
    </div>
  </header>

  <div class="wrap game-body">
    <div class="prose">{{.Body}}</div>
    <aside class="fact-sheet" aria-labelledby="facts-heading">
      <h2 id="facts-heading">At a glance</h2>
      <dl>
        {{- range .Facts}}
        <div><dt>{{.Label}}</dt><dd>{{.Value}}</dd></div>
        {{- end}}
      </dl>
      <a class="section-link" href="/press#{{.Slug}}">Press kit and key art <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <section class="wrap section" aria-labelledby="screens-heading">
    <h2 id="screens-heading">Screenshots</h2>
    <div class="screen-grid">
      {{- range .Screens}}
      <figure>
        <img src="{{asset .Src}}" alt="" width="1600" height="900" loading="lazy" decoding="async">
        <figcaption>{{.Alt}}</figcaption>
      </figure>
      {{- end}}
    </div>
  </section>

  {{- with $.posts}}
  <section class="wrap section" aria-labelledby="game-posts-heading">
    <div class="section-head">
      <h2 id="game-posts-heading">From the devlog</h2>
      <a class="section-link" href="/devlog">Every post <span aria-hidden="true">→</span></a>
    </div>
    <ol class="post-list">
      {{- range .}}{{template "post-item" (dict "post" . "hx" false)}}{{end}}
    </ol>
  </section>
  {{- end}}
</article>
{{end}}{{end}}
