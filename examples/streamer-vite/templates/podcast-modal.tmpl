<!-- Podcast Modal Content - Loaded via HTMX -->
<div class="flex items-center gap-2 text-black dark:text-neutral-400 mb-12 flex-wrap">
    <p class="text-base font-serif italic">{{.podcast.Date}}</p>
    <span>·</span>
    <p class="text-base font-serif">{{.podcast.Title}}</p>
    <span>·</span>
    <p class="text-base font-serif italic">{{.podcast.Category}}</p>
    <span>·</span>
    <p class="text-base font-serif italic">{{.podcast.Duration}}</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <!-- Left Column -->
    <div class="prose prose-sm max-w-none dark:prose-invert">
        {{if .podcast.Topics}}
        <div class="mb-8">
            <h3 class="text-base font-serif italic text-black dark:text-white mb-4">Topics</h3>
            <ul class="list-disc pl-5 space-y-2">
                {{range .podcast.Topics}}
                <li class="text-sm text-neutral-600 dark:text-neutral-400">{{.}}</li>
                {{end}}
            </ul>
        </div>
        {{end}}

        {{if .podcast.Sponsors}}
        <div class="mb-8">
            <h3 class="text-base font-serif italic text-black dark:text-white mb-4">Sponsors</h3>
            <ul class="list-none p-0 space-y-3">
                {{range .podcast.Sponsors}}
                <li class="m-0">
                    <div class="text-sm">
                        <strong class="text-black dark:text-white">{{.name}}</strong>
                        <span class="text-neutral-600 dark:text-neutral-400"> — {{.description}}</span>
                    </div>
                </li>
                {{end}}
            </ul>
        </div>
        {{end}}

        {{if .podcast.Links}}
        <div class="mb-8">
            <h3 class="text-base font-serif italic text-black dark:text-white mb-4">Links</h3>
            <ul class="list-none p-0 space-y-2">
                {{range .podcast.Links}}
                <li class="m-0">
                    <a href="{{.url}}" class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:underline no-underline">
                        {{.label}}
                    </a>
                </li>
                {{end}}
            </ul>
        </div>
        {{end}}

        {{if .podcast.ListenOn}}
        <div class="mb-8">
            <h3 class="text-base font-serif italic text-black dark:text-white mb-4">Listen on</h3>
            <ul class="list-none p-0 space-y-2">
                {{range .podcast.ListenOn}}
                <li class="m-0">
                    <a href="{{.url}}" class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:underline no-underline">
                        {{.name}}
                    </a>
                </li>
                {{end}}
            </ul>
        </div>
        {{end}}
    </div>

    <!-- Right Column - Transcript -->
    {{if .podcast.Transcript}}
    <div class="prose prose-sm max-w-none dark:prose-invert">
        <h3 class="text-base font-serif italic text-black dark:text-white mb-4">Transcript</h3>
        <div class="space-y-6 max-h-96 overflow-y-auto scrollbar-hide pr-4">
            {{range .podcast.Transcript}}
            <div class="border-l-2 border-neutral-200 dark:border-neutral-700 pl-4">
                <div class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1">{{.speaker}}</div>
                <div class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{{.text}}</div>
            </div>
            {{end}}
        </div>
    </div>
    {{else}}
    <div class="prose prose-sm max-w-none dark:prose-invert">
        <h3 class="text-base font-serif italic text-black dark:text-white mb-4">Transcript</h3>
        <div class="text-sm text-neutral-500 italic">
            Transcript coming soon...
        </div>
    </div>
    {{end}}
</div>
