{
  "name": "hyperchi-frontend",
  "version": "1.0.0",
  "description": "Minimal frontend for HyperChi component-based architecture",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:vite && npm run build:lib",
    "build:lib": "esbuild assets/scripts/hyperchi-directives.ts --bundle --format=iife --global-name=HyperChi --outfile=dist/hyperchi-directives.js --target=es2020 && esbuild assets/scripts/hyperchi-directives.ts --bundle --format=iife --global-name=HyperChi --outfile=dist/hyperchi-directives.min.js --target=es2020 --minify",
    "build:vite": "vite build",
    "preview": "vite preview",
    "watch": "esbuild assets/scripts/hyperchi-directives.ts --bundle --format=iife --global-name=HyperChi --outfile=dist/hyperchi-directives.js --target=es2020 --watch",
    "clean": "rm -rf dist",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@vue/reactivity": "^3.5.13",
    "animejs": "^4.2.2",
    "htmx.org": "4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  }
}
