# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build output
*.test
*.out

# Output of the go coverage tool
*.coverprofile

# Dependency directories (remove the comment below if you use Go modules)
vendor/

# Go workspace file
go.work
go.work.sum

# IDE/editor files
.vscode/
.idea/
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Built binaries (root and examples)
bin/

# Task runner cache
.task/

# Example binaries built directly in their module dir
# (repo convention: don't `go build` in examples/, but ignore these if they appear)
/examples/streamer/streamer
/examples/streamer-vite/streamer
/examples/streamer-vite/streamer-vite
# `go build ./...` in the CLI module writes its binary beside the source
/cmd/hyperchi/hyperchi

# Node/Vite artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
.cache/
.parcel-cache/
.vite/
coverage/

# Env files
.env
.env.*
!.env.example

# Local databases and tmp
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/tmp/
**/tmp/**
**/static/generated/

# Generated documentation
**/docs/generated/

# Agent tooling: local only, never published
.claude/
.codex/
.agents/
CLAUDE.md
AGENTS.md
FINDINGS.md

# Local release locks and SSH control sockets
examples/showcase/.release/

# Python deployment/test caches
__pycache__/
*.py[cod]
